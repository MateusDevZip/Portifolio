---
import { getCollection } from 'astro:content';
import { resolveAssetPath } from '../../utils/imagePaths';
const projects = await getCollection('projects');
// Ordem de relevancia para as vagas-alvo (dev, IA, dados), nao por ano
const sortedProjects = projects.sort((a, b) => a.data.order - b.data.order);
const NOMES_AREA = { dev: 'Desenvolvimento', ia: 'IA', dados: 'Dados' };
const FILTROS = [['todos', 'Todos'], ['dev', 'Desenvolvimento'], ['ia', 'IA'], ['dados', 'Dados']];
---

<section id="projects" class="projects-split px-[30px] lg:px-[60px] py-[100px] lg:py-[150px] relative z-10" aria-label="Projetos selecionados">
  <div class="grid lg:grid-cols-2 gap-12 lg:gap-24">

    <!-- Left: Project Names -->
    <div class="lg:sticky lg:top-[100px] xl:top-[120px] lg:self-start">
      <div class="flex items-end justify-between mb-4">
        <span id="project-counter" class="project-counter">01</span>
        <span class="text-white/20 font-space text-sm tracking-widest">/ {sortedProjects.length.toString().padStart(2, '0')}</span>
      </div>
      <div class="split-title flex items-center gap-3 mb-6">
        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
        <h2 class="uppercase text-white font-space tracking-widest text-[14px]">Trabalhos Selecionados</h2>
      </div>

      <div class="flex flex-wrap gap-2 mb-10" id="filtro-areas" role="group" aria-label="Filtrar projetos por área">
        {FILTROS.map(([valor, rotulo], i) => (
          <button type="button" data-filtro={valor} aria-pressed={i === 0 ? 'true' : 'false'}
            class="filtro-area px-4 py-2 rounded-full border border-white/20 text-white/70 font-space text-xs uppercase tracking-widest hover:border-white/60 transition-colors">
            {rotulo}
          </button>
        ))}
      </div>

      <div class="space-y-4" id="project-links">
        {sortedProjects.map((project, idx) => (
          <a href={`${import.meta.env.BASE_URL}projetos/${project.slug}`} data-areas={project.data.areas.join(' ')} class="split-project-item flex justify-between items-center py-4 pl-6 cursor-pointer group" class:list={{ active: idx === 0 }}>
            <div class="flex-1 min-w-0">
              <div class="flex flex-wrap items-center gap-3 mb-2">
                <span class="text-white/40 text-xs font-space tracking-wider block">{project.data.year}</span>
                <div class={`w-2 h-2 rounded-full animate-pulse`} style={{ backgroundColor: project.data.color }}></div>
                {project.data.areas.map((area) => (
                  <span class="text-[10px] font-space uppercase tracking-widest text-white/50 border border-white/15 rounded-full px-2 py-0.5">{NOMES_AREA[area]}</span>
                ))}
              </div>
              <h3 class="text-[28px] md:text-[40px] font-bold text-white mb-1 uppercase group-hover:translate-x-2 transition-transform break-words">{project.data.title}</h3>
              <p class="text-white/50 text-sm font-space">{project.data.category}</p>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Right: Previews -->
    <div class="split-preview space-y-16 lg:space-y-32" id="project-previews">
      {sortedProjects.map((project, idx) => (
        <div data-areas={project.data.areas.join(' ')} class={`project-preview-item project-card h-[60vh] lg:h-[75vh] w-full rounded-3xl bg-neutral-900 relative p-8 flex items-end overflow-hidden group`} class:list={{ active: idx === 0 }}>
          <div class="project-image absolute inset-0">
            {project.data.images && project.data.images[0] && (
              <img 
                src={resolveAssetPath(project.data.images[0])} 
                alt={project.data.title}
                class="w-full h-full object-cover opacity-40 group-hover:opacity-70 transition-all duration-700 group-hover:scale-110" 
              />
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent"></div>
            <div class="absolute inset-0 opacity-30" style={{ backgroundColor: project.data.color }}></div>
          </div>
          <div class="absolute top-0 right-0 w-64 h-64 rounded-full filter blur-[100px] opacity-20" style={{ backgroundColor: project.data.color }}></div>
          <div class="relative z-20">
            <h4 class="text-2xl font-bold text-white mb-2">{project.data.title}</h4>
            <p class="text-white/80 text-lg md:text-xl font-space mb-8 max-w-md line-clamp-3">{project.data.description}</p>
            <a href={`./projetos/${project.slug}`} class="inline-flex items-center gap-3 px-6 py-3 rounded-full border border-white/20 hover:bg-white hover:text-black transition-colors text-white font-space font-medium text-sm">
              Ver Projeto <span class="text-lg">↗</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Filtro por area (sem JavaScript, todos os projetos aparecem)
  const botoesFiltro = document.querySelectorAll('#filtro-areas .filtro-area');
  const itensComArea = document.querySelectorAll('#project-links [data-areas], #project-previews [data-areas]');
  const totalVisivel = document.querySelector('#projects .text-white\\/20');
  botoesFiltro.forEach((botao) => {
    botao.addEventListener('click', () => {
      const filtro = botao.dataset.filtro;
      botoesFiltro.forEach((b) => b.setAttribute('aria-pressed', b === botao ? 'true' : 'false'));
      itensComArea.forEach((item) => {
        const mostra = filtro === 'todos' || item.dataset.areas.split(' ').includes(filtro);
        item.classList.toggle('hidden', !mostra);
      });
      const visiveis = document.querySelectorAll('#project-links [data-areas]:not(.hidden)').length;
      if (totalVisivel) totalVisivel.textContent = `/ ${String(visiveis).padStart(2, '0')}`;
      // recomeca do primeiro visivel: contador e selecao ativa
      const contador = document.getElementById('project-counter');
      if (contador) contador.textContent = '01';
      document.querySelectorAll('.split-project-item, .project-preview-item').forEach((el) => el.classList.remove('active'));
      document.querySelector('#project-links [data-areas]:not(.hidden)')?.classList.add('active');
      document.querySelector('#project-previews [data-areas]:not(.hidden)')?.classList.add('active');
    });
  });
</script>

<script>
  // Projects scroll spy animation
  if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
    const projectItems = document.querySelectorAll('.split-project-item');
    const projectPreviews = document.querySelectorAll('.project-preview-item');
    const counter = document.getElementById('project-counter');

    projectItems.forEach((item, idx) => {
      item.addEventListener('mouseenter', () => {
        // Update counter
        if (counter) {
          counter.textContent = (idx + 1).toString().padStart(2, '0');
        }

        // Update active states
        projectItems.forEach(el => el.classList.remove('active'));
        projectPreviews.forEach(el => el.classList.remove('active'));
        item.classList.add('active');
        if (projectPreviews[idx]) projectPreviews[idx].classList.add('active');

        // Animate preview
        if (projectPreviews[idx]) {
          gsap.from(projectPreviews[idx], {
            opacity: 0,
            y: 20,
            duration: 0.3
          });
        }
      });
    });
  }
</script>

<style>
  .split-project-item {
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    transition: border-color 0.3s ease;
  }

  .split-project-item:hover {
    border-bottom-color: rgba(255, 255, 255, 0.3);
  }

  .split-project-item.active {
    border-bottom-color: rgba(255, 255, 255, 0.5);
  }

  .project-card {
    transition: transform 0.3s ease;
  }

  .project-card.active {
    transform: scale(1);
  }

  .filtro-area[aria-pressed='true'] {
    background: #fff;
    color: #000;
    border-color: #fff;
  }
</style>
