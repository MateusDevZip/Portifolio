---
// So o que esta no curriculo do Mateus (nada de tecnologia que ele nao usou)
const skills = [
  { name: 'FULL-STACK', quote: '‟ React, TypeScript e Node.js: do zero até o sistema em produção. "' },
  { name: 'PYTHON / FLASK', quote: '‟ Back-ends e automações em Python, com Flask e SQLite. "' },
  { name: 'IA APLICADA', quote: '‟ LLMs dentro de produtos, com verificação para não inventar dados. "' },
  { name: 'DADOS / BI', quote: '‟ SQL, Power BI e Looker Studio para transformar dados em decisão. "' },
  { name: 'AUTOMAÇÃO', quote: '‟ Playwright, Make.com e webhooks no lugar do trabalho repetitivo. "' },
  { name: 'TESTES', quote: '‟ Teste antes do código: é o que deixa confiar no que roda sozinho. "' },
  { name: 'MARTECH', quote: '‟ Google Analytics 4 e Tag Manager ligando marketing e dados. "' },
];
---

<section class="py-[120px] lg:py-[200px] relative grid grid-cols-12 px-[15px] lg:px-[20px] z-10 overflow-x-hidden" aria-label="Habilidades técnicas">
  <div class="col-span-3 relative hidden lg:block">
    <div class="sticky top-[50%] -translate-y-1/2 text-white -rotate-90 w-[500px] -left-32">
      <p id="skill-citation" class="font-light tracking-wide text-xl ml-10">
        ‟ React, TypeScript e Node.js: do zero até o sistema em produção. "
      </p>
    </div>
  </div>
  <div class="col-span-12 lg:col-span-9 flex flex-col gap-10 md:gap-14" id="skills-list">
    {skills.map(skill => (
      <p class="about-item skills-item-text uppercase font-bold text-left xl:text-right leading-none xl:whitespace-nowrap" data-quote={skill.quote}>
        {skill.name}
      </p>
    ))}
  </div>
</section>

<script>
  // Skills hover animation
  if (typeof gsap !== 'undefined') {
    const skillItems = document.querySelectorAll('.skills-item-text');
    const skillCitation = document.getElementById('skill-citation');

    skillItems.forEach((item) => {
      item.addEventListener('mouseenter', () => {
        const quote = item.getAttribute('data-quote');
        if (skillCitation && quote) {
          gsap.to(skillCitation, {
            opacity: 0,
            duration: 0.2
          });
          setTimeout(() => {
            skillCitation.textContent = quote;
            gsap.to(skillCitation, {
              opacity: 1,
              duration: 0.2
            });
          }, 100);
        }
      });
    });
  }
</script>
